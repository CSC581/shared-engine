digraph ClientServerFlow {
    graph [rankdir=LR, bgcolor="#F8FAFC", pad="0.25", nodesep="0.3", ranksep="0.45", splines=spline];
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, penwidth=1.2, color="#9CB5C2", fillcolor="#FFFFFF", fontcolor="#193547", margin="0.15,0.1"];
    edge [color="#478299", penwidth=1.3, arrowsize=0.72, fontname="Helvetica", fontsize=10, fontcolor="#365A6B"];

    game [label="Game\nsimulates its own player"];
    session [label="Multiplayer::Session\n(client-server mode)\nNetworkClient inside"];

    subgraph cluster_server {
        label="Headless server (NetworkServerHost, Dedicated)";
        fontname="Helvetica"; fontsize=11; fontcolor="#365A6B";
        style="rounded,dashed"; color="#9CB5C2";
        handshake [label="Public socket :5555\naccepts JOIN only"];
        worker [label="Private worker thread\none per client", fillcolor="#E8F4F2", color="#64A49A"];
        store [label="Shared state (NetworkServer)\nplayers + platforms, locked"];
        tick [label="Platform thread\nmoves platforms on real time", fillcolor="#FFF7E6", color="#D9A441"];
    }

    game -> session [label="publishLocalPlayer(x, y, data)"];
    session -> handshake [dir=both, label="1. JOIN / WELCOME\n(+ private worker address)"];
    handshake -> worker [style=dashed, label="starts"];
    session -> worker [dir=both, label="2. POSITION / SNAPSHOT"];
    worker -> store [dir=both];
    tick -> store;
    session -> game [label="remotePlayers(), platforms()"];
}
