digraph FrameTimeFlow {
    graph [rankdir=LR, bgcolor="#F8FAFC", pad="0.25", nodesep="0.3", ranksep="0.35", splines=spline, newrank=true];
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, penwidth=1.2, color="#9CB5C2", fillcolor="#FFFFFF", fontcolor="#193547", margin="0.15,0.1"];
    edge [color="#478299", penwidth=1.3, arrowsize=0.72, fontname="Helvetica", fontsize=10, fontcolor="#365A6B"];

    // One pass of Engine::run, left to right.
    events [label="1. SDL events\n+ keyboard poll"];
    input [label="2. Game::handleInput\n(e.g. P / 1 / 2 / 3)"];
    frame [label="3. FrameTime\ngame seconds since\nlast frame", fillcolor="#E8F4F2", color="#64A49A"];
    update [label="4. Game::update\nmove objects by dt"];
    render [label="5. Game::render\nengine presents"];
    events -> input -> frame -> update -> render;

    // The clocks underneath.
    real [label="Real time\nnever paused", fillcolor="#FFF7E6", color="#D9A441"];
    game [label="Game time\npause / scale 0.5x-2x", fillcolor="#E8F4F2", color="#64A49A"];
    timer [label="Frame timer\ncaps a long frame"];
    loops [label="Loop time\none tic per frame"];
    net [label="Networking, retries,\ninput while paused", fillcolor="#FFF7E6", color="#D9A441"];

    real -> game -> timer -> frame;
    real -> net [style=dashed];
    input -> game [style=dashed, label="pause / scale"];
    events -> loops [style=dashed, label="advance"];

    { rank=same; events; real; }
    { rank=same; frame; timer; }
}
