digraph EventFlow {
    graph [rankdir=LR, bgcolor="#F8FAFC", pad="0.25", nodesep="0.3", ranksep="0.45", splines=spline, newrank=true];
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, penwidth=1.2, color="#9CB5C2", fillcolor="#FFFFFF", fontcolor="#193547", margin="0.15,0.1"];
    edge [color="#478299", penwidth=1.3, arrowsize=0.72, fontname="Helvetica", fontsize=10, fontcolor="#365A6B"];

    // Who raises events.
    input [label="Engine input step\nInputEvent (keys, chords)"];
    world [label="World collision pass\nCollisionEvent"];
    rules [label="Game rules\nDeathEvent, SpawnEvent"];
    workers [label="Worker threads\nany event"];

    // Raising only queues.
    raise [label="raise(event, delay)\nqueues only", fillcolor="#E8F4F2", color="#64A49A"];
    queue [label="Queue\nordered by delivery time,\nthen priority, then raise order", fillcolor="#E8F4F2", color="#64A49A"];
    clock [label="Game time\npauses and scales", fillcolor="#FFF7E6", color="#D9A441"];

    // Handling happens at two fixed points in the frame.
    dispatch [label="dispatch()\nafter input and\nafter the game update", fillcolor="#E8F4F2", color="#64A49A"];
    byType [label="subscribe(type)\nhandlers"];
    all [label="subscribeAll\nhandlers"];
    listener [label="EventListener\non a game object"];

    input -> raise;
    world -> raise;
    rules -> raise;
    workers -> raise;
    raise -> queue -> dispatch;
    dispatch -> byType;
    dispatch -> all;
    dispatch -> listener;

    clock -> queue [style=dashed, label="timestamps"];
    // Handlers may raise more events; they run in later rounds of the same dispatch.
    // Drawn queue -> dispatch with the arrow reversed, so it sits beside the
    // main arrow instead of looping across the picture.
    queue -> dispatch [dir=back, style=dashed, label="handlers raise more events:\nlater rounds, at most 8 rounds\nand 1,000 events per dispatch"];

    { rank=same; raise; clock; }
}
