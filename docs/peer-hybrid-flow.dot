digraph PeerHybridFlow {
    graph [rankdir=LR, bgcolor="#F8FAFC", pad="0.25", nodesep="0.3", ranksep="0.45", splines=spline];
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, penwidth=1.2, color="#9CB5C2", fillcolor="#FFFFFF", fontcolor="#193547", margin="0.15,0.1"];
    edge [color="#478299", penwidth=1.3, arrowsize=0.72, fontname="Helvetica", fontsize=10, fontcolor="#365A6B"];

    game [label="Game"];
    session [label="Multiplayer::Session\n(peer-to-peer mode)"];
    mesh [label="PeerSession\nplayer data", fillcolor="#E8F4F2", color="#64A49A"];
    known [label="Any running peer\n(bootstrapPeers)"];
    peers [label="Other peers"];
    world [label="WorldStateClient\noptional", fillcolor="#FFF7E6", color="#D9A441"];
    authority [label="Platform authority\nnetwork-server, or hosted\ninside one player (--host)"];

    game -> session [label="publishLocalPlayer(x, y, data)"];
    session -> mesh;
    mesh -> known [label="1. HELLO", style=dashed];
    known -> mesh [label="ROSTER: every peer's address", style=dashed];
    mesh -> peers [dir=both, label="2. STATE, PING, LEAVE\n(direct, no server)"];
    session -> world [style=dashed, label="if serverEndpoint set"];
    world -> authority [dir=both, label="GET_WORLD / WORLD_STATE\nplatforms only"];
    session -> game [label="remotePlayers(), platforms()"];
}
