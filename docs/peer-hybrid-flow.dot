digraph PeerHybridFlow {
    graph [rankdir=LR, bgcolor="#F8FAFC", pad="0.25", nodesep="0.42", ranksep="0.5", splines=polyline];
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, penwidth=1.2, color="#9CB5C2", fillcolor="#FFFFFF", fontcolor="#193547", margin="0.18,0.13"];
    edge [color="#478299", penwidth=1.3, arrowsize=0.72, fontname="Helvetica", fontsize=10, fontcolor="#365A6B"];

    game [label="Multiplayer::Session\nselected by the game"];
    mesh [label="PeerSession\nplayer state", fillcolor="#E8F4F2", color="#64A49A"];
    peers [label="Other peers"];
    players [label="Game reads\nremote players"];
    world [label="WorldStateClient\noptional", fillcolor="#E8F4F2", color="#64A49A"];
    authority [label="Dedicated or hosted\nplatform authority"];
    platforms [label="Game reads\nshared platforms"];

    game -> mesh;
    mesh -> peers [dir=both, label="player data"];
    mesh -> players;
    game -> world [style=dashed, label="if configured"];
    world -> authority [dir=both, label="platforms only"];
    world -> platforms;
}
